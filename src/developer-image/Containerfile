FROM node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20 AS frontend
WORKDIR /web
COPY src/research-portal/frontend/package.json src/research-portal/frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY src/research-portal/frontend/ ./
RUN npm run build

FROM python:3.13-slim-bookworm@sha256:a1165e272e578941b84abc79e4ab38a0305cd12803a5c4247979ac7655f4d641 AS prepared
WORKDIR /opt/caldova-lab
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/opt/caldova-lab \
    CALDOVA_ACCEPTANCE_PURPOSE=synthetic-development \
    CALDOVA_PREVIEW_STATE=starter \
    CALDOVA_DATA_DIR=/opt/caldova-lab/data/artifacts/development \
    CALDOVA_STATIC_DIR=/opt/caldova-lab/src/research-portal/frontend/dist \
    TMPDIR=/opt/caldova-lab/.runtime
COPY --from=frontend /usr/local/bin/node /usr/local/bin/node
COPY --from=frontend /usr/local/lib/node_modules/ /usr/local/lib/node_modules/
RUN mkdir .runtime \
    && apt-get update && apt-get install -y --no-install-recommends libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
COPY data/pipeline/ data/pipeline/
COPY data/fixtures/research-data.json data/fixtures/research-data.json
COPY src/research-portal/backend/requirements.txt src/research-portal/backend/requirements.txt
RUN pip install --no-cache-dir -r src/research-portal/backend/requirements.txt && pip check
COPY src/research-portal/backend/app.py src/research-portal/backend/queries.py src/research-portal/backend/
COPY src/research-portal/Containerfile src/research-portal/Containerfile
COPY --from=frontend /web/ src/research-portal/frontend/
COPY tests/test_research.py tests/test_research.py
COPY tests/test_frozen_public_research.py tests/test_frozen_public_research.py
COPY src/workers/frozen_contract.py src/workers/frozen_contract.py
COPY src/workers/starter/ src/workers/starter/
COPY src/developer-image/baseline.py src/developer-image/baseline.py
RUN python -m data.pipeline.build_dataset \
        --input data/fixtures/research-data.json --output data/artifacts/development \
    && python -m data.pipeline.validate_dataset --manifest data/artifacts/development/data-manifest.json \
    && useradd --uid 10001 --create-home caldova \
    && chown caldova:caldova .runtime

FROM prepared AS reference-validation
COPY src/research-portal/backend/trial_feature.py src/research-portal/backend/safety_feature.py src/research-portal/backend/
RUN CALDOVA_PREVIEW_STATE=reference CALDOVA_EXPECTED_PREVIEW_STATE=reference \
        python -m unittest discover -s tests -p test_research.py -v \
    && printf '%s\n' 'Dataset-specific trusted reference research checks passed.' > reference-validation.txt

FROM reference-validation AS reference-release
ARG SOURCE_REVISION=uncommitted-development
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}" io.caldova.preview-state="reference"
ENV CALDOVA_PREVIEW_STATE=reference
USER caldova
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)"
CMD ["uvicorn", "app:app", "--app-dir", "src/research-portal/backend", "--host", "0.0.0.0", "--port", "8080"]

FROM prepared AS baseline
ARG SOURCE_REVISION=uncommitted-development
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}" io.caldova.preview-state="starter"
COPY src/workers/starter/trial_feature.py src/workers/starter/safety_feature.py src/research-portal/backend/
RUN chmod -R go-w /opt/caldova-lab \
    && python src/developer-image/baseline.py --record --source-revision "${SOURCE_REVISION}" \
    && chown caldova:caldova src/research-portal/backend/trial_feature.py src/research-portal/backend/safety_feature.py
USER caldova
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)"
CMD ["uvicorn", "app:app", "--app-dir", "src/research-portal/backend", "--host", "0.0.0.0", "--port", "8080"]

FROM baseline AS validation
COPY --from=reference-validation /opt/caldova-lab/reference-validation.txt /opt/caldova-lab/reference-validation.txt
RUN python src/developer-image/baseline.py

FROM validation AS release
