    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.App/sandboxGroups', parameters('sandboxGroupName'))]",
      "name": "[coalesce(tryGet(parameters('roleAssignmentNames'), 'runtimeSandbox'), guid(resourceId('Microsoft.App/sandboxGroups', parameters('sandboxGroupName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), variables('sandboxOwnerRole')))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('sandboxOwnerRole'))]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
