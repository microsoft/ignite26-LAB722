              "server": "[reference(resourceId('Microsoft.ContainerRegistry/registries', parameters('registryName')), '2023-07-01').loginServer]",
              "identity": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName'))]"
            }
          ],
          "secrets": [
            {
              "name": "proof-key",
              "value": "[parameters('proofKey')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "[parameters('appName')]",
              "image": "[parameters('image')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": [
                {
                  "name": "PROOF_KEY",
                  "secretRef": "proof-key"
                },
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', parameters('identityName')), '2023-01-31').clientId]"
                },
                {
                  "name": "AZURE_SUBSCRIPTION_ID",
                  "value": "[subscription().subscriptionId]"
                },
                {
                  "name": "RESOURCE_GROUP",
                  "value": "[resourceGroup().name]"
                },
                {
                  "name": "SANDBOX_GROUP",
                  "value": "[parameters('sandboxGroupName')]"
                },
                {
                  "name": "SANDBOX_ID",
                  "value": "[parameters('sandboxId')]"
                },
                {
