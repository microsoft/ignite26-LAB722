      }
    },
    "sandboxId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "metadata": {
        "description": "Existing execution Sandbox ID from the verified clean baseline; not a tenant selected by the model."
      }
    },
    "proofKey": {
      "type": "securestring",
      "minLength": 32
