{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "${AZURE_LOCATION=westus3}"
    },
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "labUserPrincipalId": {
      "value": "${LAB_USER_PRINCIPAL_ID=}"
    },
    "labUserPrincipalType": {
      "value": "${LAB_USER_PRINCIPAL_TYPE=User}"
    },
    "foundryUserRoleAssignmentName": {
      "value": "${FOUNDRY_USER_ROLE_ASSIGNMENT_NAME=}"
    },
    "modelName": {
      "value": "${FOUNDRY_MODEL_NAME=gpt-5.2}"
    },
    "modelVersion": {
      "value": "${FOUNDRY_MODEL_VERSION=2025-12-11}"
    },
    "modelFormat": {
      "value": "${FOUNDRY_MODEL_FORMAT=OpenAI}"
    },
    "modelSkuName": {
      "value": "${FOUNDRY_MODEL_SKU=GlobalStandard}"
    },
    "modelCapacity": {
      "value": "${FOUNDRY_MODEL_CAPACITY=40}"
    },
    "sandboxMaxCount": {
      "value": "${SANDBOX_MAX_COUNT=8}"
    }
  }
}
